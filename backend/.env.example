DATABASE_URL=sqlite:///grade_tracker.db
# Default local DB is SQLite. For production (Railway), set this to your PostgreSQL URL (auto-provided by Railway plugin)

JWT_SECRET_KEY=change-me-in-production
# Generate a strong random secret (e.g. openssl rand -hex 32)

FLASK_APP=run.py
FLASK_ENV=production

ADMIN_EMAIL=admin@school.edu
# First admin login email — used to bootstrap admin on first deploy

ADMIN_PASSWORD=changeme
# First admin login password — used to bootstrap admin on first deploy

FRONTEND_URL=http://localhost:5173
# Set to your Railway frontend service public URL in production
